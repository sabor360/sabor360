# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local Figma references; only production assets are committed
/public/assets/figma/*
!/public/assets/figma/logo.png
!/public/assets/figma/ref-hero.jpg
!/public/assets/figma/ref-battery-opt.png
!/public/assets/figma/ref-process.jpg
!/public/assets/figma/raw-02.png
!/public/assets/figma/raw-03.png
!/public/assets/figma/raw-05-opt.png
!/public/assets/figma/raw-16-opt.png
!/public/assets/figma/raw-19.jpeg
!/public/assets/figma/pricing-case-1.jpg
!/public/assets/figma/pricing-case-2.jpg
!/public/assets/figma/pricing-case-3.jpg

# unused starter icons
/public/favicon.svg
/public/file.svg
/public/globe.svg
/public/window.svg
